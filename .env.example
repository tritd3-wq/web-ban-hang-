# Set in Vercel for Preview/Production and in .env.local for local development.
DATABASE_URL=
ADMIN_USERNAME=
# Generate with npm run admin:hash. Use a unique password of at least 12 characters.
ADMIN_PASSWORD_HASH=
# Public Vercel Blob store, for website images.
BLOB_READ_WRITE_TOKEN=
# From a verified Resend domain, e.g. Viettel Dong Nai <tu-van@your-domain.example>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
